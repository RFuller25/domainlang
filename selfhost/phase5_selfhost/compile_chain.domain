                                    consider lIdx as last(vs1) in
                                    consider vs2 as take(vs1, length(vs1) - 1) in
                                    consider newIdx as length(parseArena) in
                                        (((v also parseArena := concat(parseArena, list(record("kind", opsym, "text", "", "num", 0, "left", lIdx, "right", rIdx, "line", bt.line, "kids", emptylist(0), "toks", emptylist(tokWitness), "stageKind", "", "stageArg", ""))))
                                            also valstackE := concat(vs2, list(newIdx)))
                                            also opstackE := take(opstackE, length(opstackE) - 1))
