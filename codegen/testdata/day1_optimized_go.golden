func dmTopK(xs []int64, k int, desc bool) []int64 {
	if k <= 0 || len(xs) == 0 {
		return []int64{}
	}
	if k > len(xs) {
		k = len(xs)
	}
	a := append([]int64(nil), xs...)
	front := func(x, y int64) bool {
		if desc {
			return x > y
		}
		return x < y
	}
	lo, hi := 0, len(a)-1
	for lo < hi {
		mid := lo + (hi-lo)/2
		a[mid], a[hi] = a[hi], a[mid]
		pivot := a[hi]
		i := lo
		for j := lo; j < hi; j++ {
			if front(a[j], pivot) {
				a[i], a[j] = a[j], a[i]
				i++
			}
		}
		a[i], a[hi] = a[hi], a[i]
		switch {
		case i == k-1:
			lo, hi = 0, -1 // done
		case i < k-1:
			lo = i + 1
		default:
			hi = i - 1
		}
	}
	res := a[:k]
	sort.Slice(res, func(i, j int) bool { return front(res[i], res[j]) })
	return res
}

