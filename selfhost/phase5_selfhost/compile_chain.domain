Cursed Energy: stdin
Cursed Object: srcText Of Itself
Cursed Object: lines As split(srcText, "\n")
Cursed Object: ln As length(lines)

Cursed Object: indents As list(0)
Cursed Object: toks As emptylist(record("kind", "", "text", "", "line", 0))
Cursed Object: li As 0
Cursed Object: inString As 0
Cursed Object: strbuf As ""

Cursed Technique: Apply
    Using: (v) -> 0
Simple Domain: While
    Using: (v) -> li < ln
    Cursed Object: raw Of (v) -> item(lines, li)
    Cursed Object: content Of (v) -> trim(raw)
    Cursed Object: width Of (v) -> length(raw) - length(content)
    Cursed Object: isCode Of (v) -> ikke (length(content) = 0 or charat(content, 0) = "#")

    Cursed Technique: Apply
        Using: (v) -> (
            if ikke isCode then
                v
            else if width > last(indents) then
                ((v also indents := concat(indents, list(width)))
                    also toks := concat(toks, list(record("kind", "INDENT", "text", "", "line", li + 1))))
            else
                v
        )

    Simple Domain: While
        Using: (v) -> isCode and length(indents) > 1 and last(indents) > width
        Cursed Technique: Apply
            Using: (v) -> ((v also indents := take(indents, length(indents) - 1))
                also toks := concat(toks, list(record("kind", "DEDENT", "text", "", "line", li + 1))))

    Cursed Object: ci As 0
    Cursed Object: cn Of (v) -> length(content)
    Cursed Technique: Apply
        Using: (v) -> 0
    Simple Domain: While
        Using: (v) -> isCode and ci < cn
        Cursed Object: ch Of (v) -> charat(content, ci)
        Cursed Object: ch2 Of (v) -> (if ci + 1 < cn then charat(content, ci + 1) else "")
        Cursed Technique: Apply
            Using: (v) -> (
                if inString = 1 then
                    (
                        if ch = "\"" then
                            (((v also toks := concat(toks, list(record("kind", "STRING", "text", strbuf, "line", li + 1))))
                                also inString := 0) also ci := ci + 1)
                        else if ch = "\\" and ch2 = "\"" then
                            ((v also strbuf := strbuf + "\"") also ci := ci + 2)
                        else if ch = "\\" and ch2 = "n" then
                            ((v also strbuf := strbuf + "\n") also ci := ci + 2)
                        else if ch = "\\" and ch2 = "\\" then
                            ((v also strbuf := strbuf + "\\") also ci := ci + 2)
                        else
                            ((v also strbuf := strbuf + ch) also ci := ci + 1)
                    )
                else if ch = "\"" then
                    (((v also inString := 1) also strbuf := "") also ci := ci + 1)
                else if ch = "#" then
                    (v also ci := cn)
                else if ch = " " then
                    ((v also toks := concat(toks, list(record("kind", "SPACE", "text", "", "line", li + 1)))) also ci := ci + 1)
                else if isdigit(ch) then
                    ((v also toks := concat(toks, list(record("kind", "DIGIT", "text", ch, "line", li + 1)))) also ci := ci + 1)
                else if isalpha(ch) or ch = "_" then
                    ((v also toks := concat(toks, list(record("kind", "LETTER", "text", ch, "line", li + 1)))) also ci := ci + 1)
                else if ch = "-" and ch2 = ">" then
                    ((v also toks := concat(toks, list(record("kind", "ARROW", "text", "->", "line", li + 1))))
                        also ci := ci + 2)
                else if ch = ":" and ch2 = "=" then
                    ((v also toks := concat(toks, list(record("kind", "ASSIGN", "text", ":=", "line", li + 1))))
                        also ci := ci + 2)
                else if ch = "<" and ch2 = "=" then
                    ((v also toks := concat(toks, list(record("kind", "LE", "text", "<=", "line", li + 1))))
                        also ci := ci + 2)
                else if ch = ">" and ch2 = "=" then
                    ((v also toks := concat(toks, list(record("kind", "GE", "text", ">=", "line", li + 1))))
                        also ci := ci + 2)
                else if ch = ":" then
                    ((v also toks := concat(toks, list(record("kind", "COLON", "text", ":", "line", li + 1)))) also ci := ci + 1)
                else if ch = "," then
                    ((v also toks := concat(toks, list(record("kind", "COMMA", "text", ",", "line", li + 1)))) also ci := ci + 1)
                else if ch = "." then
                    ((v also toks := concat(toks, list(record("kind", "DOT", "text", ".", "line", li + 1)))) also ci := ci + 1)
                else if ch = "(" then
                    ((v also toks := concat(toks, list(record("kind", "LPAREN", "text", "(", "line", li + 1)))) also ci := ci + 1)
                else if ch = ")" then
                    ((v also toks := concat(toks, list(record("kind", "RPAREN", "text", ")", "line", li + 1)))) also ci := ci + 1)
                else if ch = "+" then
                    ((v also toks := concat(toks, list(record("kind", "PLUS", "text", "+", "line", li + 1)))) also ci := ci + 1)
                else if ch = "-" then
                    ((v also toks := concat(toks, list(record("kind", "MINUS", "text", "-", "line", li + 1)))) also ci := ci + 1)
                else if ch = "*" then
                    ((v also toks := concat(toks, list(record("kind", "STAR", "text", "*", "line", li + 1)))) also ci := ci + 1)
                else if ch = "/" then
                    ((v also toks := concat(toks, list(record("kind", "SLASH", "text", "/", "line", li + 1)))) also ci := ci + 1)
                else if ch = "%" then
                    ((v also toks := concat(toks, list(record("kind", "PERCENT", "text", "%", "line", li + 1)))) also ci := ci + 1)
                else if ch = "=" then
                    ((v also toks := concat(toks, list(record("kind", "EQ", "text", "=", "line", li + 1)))) also ci := ci + 1)
                else if ch = "<" then
                    ((v also toks := concat(toks, list(record("kind", "LT", "text", "<", "line", li + 1)))) also ci := ci + 1)
                else if ch = ">" then
                    ((v also toks := concat(toks, list(record("kind", "GT", "text", ">", "line", li + 1)))) also ci := ci + 1)
                else if ch = "{" then
                    ((v also toks := concat(toks, list(record("kind", "LBRACE", "text", "{", "line", li + 1)))) also ci := ci + 1)
                else if ch = "}" then
                    ((v also toks := concat(toks, list(record("kind", "RBRACE", "text", "}", "line", li + 1)))) also ci := ci + 1)
                else
                    (v also ci := ci + 1)
            )
    Cursed Technique: Apply
        Using: (v) -> (if isCode then (v also toks := concat(toks, list(record("kind", "NEWLINE", "text", "", "line", li + 1)))) else v)
    Cursed Technique: Apply
        Using: (v) -> (v also li := li + 1)

Simple Domain: While
    Using: (v) -> length(indents) > 1
    Cursed Technique: Apply
        Using: (v) -> ((v also indents := take(indents, length(indents) - 1))
            also toks := concat(toks, list(record("kind", "DEDENT", "text", "", "line", ln + 1))))

Cursed Technique: Apply
    Using: (v) -> toks
Reveal: stderr

Cursed Object: tn As length(toks)
Cursed Object: ti As 0
Cursed Object: buf2 As ""
Cursed Object: toks2 As emptylist(record("kind", "", "text", "", "line", 0))
Cursed Technique: Apply
    Using: (v) -> 0
Simple Domain: While
    Using: (v) -> ti < tn
    Cursed Object: tk Of (v) -> item(toks, ti)
    Cursed Object: wordish Of (v) -> (tk.kind = "DIGIT" or tk.kind = "LETTER")
    Cursed Technique: Apply
        Using: (v) -> (
            if wordish then
                ((v also buf2 := buf2 + tk.text) also ti := ti + 1)
            else if tk.kind = "SPACE" then
                (((v also toks2 := (if buf2 = "" then toks2 else concat(toks2, list(record("kind", (if isdigit(buf2) then "INT" else "IDENT"), "text", buf2, "line", tk.line)))))
                    also buf2 := "")
                    also ti := ti + 1)
            else
                ((((v also toks2 := (if buf2 = "" then toks2 else concat(toks2, list(record("kind", (if isdigit(buf2) then "INT" else "IDENT"), "text", buf2, "line", tk.line)))))
                    also buf2 := "")
                    also toks2 := concat(toks2, list(tk)))
                    also ti := ti + 1)
        )

Cursed Technique: Apply
    Using: (v) -> (v also toks2 := (if buf2 = "" then toks2 else concat(toks2, list(record("kind", (if isdigit(buf2) then "INT" else "IDENT"), "text", buf2, "line", ln)))))
Cursed Technique: Apply
    Using: (v) -> toks2
Reveal: stderr

Cursed Object: tokWitness As record("kind", "", "text", "", "line", 0)
Cursed Object: nodeWitness As record("kind", "ROOT", "text", "", "num", 0, "left", 0 - 1, "right", 0 - 1, "line", 0, "kids", emptylist(0), "toks", emptylist(tokWitness), "stageKind", "", "stageArg", "")

Cursed Object: parseArena As list(nodeWitness)
Cursed Object: pstack As list(0)
Cursed Object: lastLineIdx As (0 - 1)
Cursed Object: pendingToks As emptylist("")
Cursed Object: pendingTokRecs As emptylist(tokWitness)
Cursed Object: pi As 0
Cursed Object: pn As length(toks2)

Cursed Technique: Apply
    Using: (v) -> 0
Simple Domain: While
    Using: (v) -> pi < pn
    Cursed Object: t Of (v) -> item(toks2, pi)
    Cursed Technique: Apply
        Using: (v) -> (
            if t.kind = "INDENT" then
                ((v also pstack := concat(pstack, list(lastLineIdx))) also pi := pi + 1)
            else if t.kind = "DEDENT" then
                ((v also pstack := take(pstack, length(pstack) - 1)) also pi := pi + 1)
            else if t.kind = "NEWLINE" then
                consider newIdx as length(parseArena) in
                consider lineText as textjoin(pendingToks, " ") in
                consider parentIdx as last(pstack) in
                consider parentNode as item(parseArena, parentIdx) in
                consider newLine as record("kind", "LINE", "text", lineText, "num", 0, "left", 0 - 1, "right", 0 - 1, "line", t.line, "kids", emptylist(0), "toks", pendingTokRecs, "stageKind", "", "stageArg", "") in
                consider updatedParent as record("kind", parentNode.kind, "text", parentNode.text, "num", parentNode.num, "left", parentNode.left, "right", parentNode.right, "line", parentNode.line, "kids", concat(parentNode.kids, list(newIdx)), "toks", parentNode.toks, "stageKind", parentNode.stageKind, "stageArg", parentNode.stageArg) in
                    ((((((v also parseArena := concat(parseArena, list(newLine)))
                        also parseArena := set(parseArena, parentIdx, updatedParent))
                        also lastLineIdx := newIdx)
                        also pendingToks := emptylist(""))
                        also pendingTokRecs := emptylist(tokWitness))
                        also pi := pi + 1)
            else
                (((v also pendingToks := concat(pendingToks, list(t.text))) also pendingTokRecs := concat(pendingTokRecs, list(t))) also pi := pi + 1)
        )

Cursed Technique: Apply
    Using: (v) -> parseArena
Reveal: stderr

Cursed Object: numLines As length(parseArena)
Cursed Object: li2 As 0
Cursed Object: curToks As emptylist(tokWitness)
Cursed Object: curLen As 0
Cursed Object: arrowPos As (0 - 1)
Cursed Object: aj As 0
Cursed Object: bodyToks As emptylist(tokWitness)
Cursed Object: bodyLen As 0
Cursed Object: valstackE As emptylist(0)
Cursed Object: opstackE As emptylist("")
Cursed Object: kE As 0
Cursed Object: waitingE As ""
Cursed Object: cj As 0
Cursed Object: unsupported As 0
Cursed Object: parenIsCall As emptylist(0)
Cursed Object: parenFuncName As emptylist("")
Cursed Object: parenValLen As emptylist(0)
Cursed Object: expectPrimary As 1
Cursed Object: ifCondStack As emptylist(0)
Cursed Object: ifThenStack As emptylist(0)

Cursed Technique: Apply
    Using: (v) -> 0
Simple Domain: While
    Using: (v) -> li2 < numLines
    Cursed Object: lnode Of (v) -> item(parseArena, li2)
    Cursed Object: isUsing Of (v) -> (lnode.kind = "LINE" and length(lnode.toks) >= 2 and item(lnode.toks, 0).kind = "IDENT" and item(lnode.toks, 0).text = "Using")

    Cursed Technique: Apply
        Using: (v) -> ((((((v also curToks := (if isUsing then lnode.toks else emptylist(tokWitness)))
            also curLen := (if isUsing then length(lnode.toks) else 0))
            also arrowPos := (0 - 1))
            also aj := 0)
            also bodyToks := emptylist(tokWitness))
            also bodyLen := 0)

    Simple Domain: While
        Using: (v) -> aj < curLen and arrowPos = (0 - 1)
        Cursed Object: atok Of (v) -> item(curToks, aj)
        Cursed Technique: Apply
            Using: (v) -> (
                if atok.kind = "ARROW" then
                    ((v also arrowPos := aj) also aj := aj + 1)
                else
                    (v also aj := aj + 1)
            )

    Cursed Technique: Apply
        Using: (v) -> (
            if arrowPos = (0 - 1) then
                v
            else
                ((v also bodyToks := slice(curToks, arrowPos + 1, curLen)) also bodyLen := (curLen - arrowPos - 1))
        )

    Cursed Technique: Apply
        Using: (v) -> ((v also cj := 0) also unsupported := 0)

    Simple Domain: While
        Using: (v) -> cj < bodyLen and unsupported = 0
        Cursed Object: sup Of (v) -> item(bodyToks, cj)
        Cursed Technique: Apply
            Using: (v) -> (
                if sup.kind = "INT" or sup.kind = "IDENT" or sup.kind = "STRING" or sup.kind = "PLUS" or sup.kind = "MINUS" or sup.kind = "STAR" or sup.kind = "SLASH" or sup.kind = "PERCENT" or sup.kind = "EQ" or sup.kind = "LT" or sup.kind = "GT" or sup.kind = "LE" or sup.kind = "GE" or sup.kind = "LPAREN" or sup.kind = "RPAREN" or sup.kind = "COMMA" or sup.kind = "DOT" then
                    (v also cj := cj + 1)
                else
                    (v also unsupported := 1)
            )

    Cursed Technique: Apply
        Using: (v) -> ((((((((((v also valstackE := emptylist(0)) also opstackE := emptylist("")) also kE := 0) also waitingE := "")
            also parenIsCall := emptylist(0)) also parenFuncName := emptylist("")) also parenValLen := emptylist(0)) also expectPrimary := 1)
            also ifCondStack := emptylist(0)) also ifThenStack := emptylist(0))

    Simple Domain: While
        Using: (v) -> unsupported = 0 and (kE < bodyLen or ikke waitingE = "")
        Cursed Object: bt Of (v) -> (if kE < bodyLen then item(bodyToks, kE) else tokWitness)
        Cursed Object: bt2 Of (v) -> (if kE + 1 < bodyLen then item(bodyToks, kE + 1) else tokWitness)
        Cursed Technique: Apply
            Using: (v) -> (
                if waitingE = "" then
                    if bt.kind = "INT" then
                        consider newIdx as length(parseArena) in
                            ((((v also parseArena := concat(parseArena, list(record("kind", "NUM", "text", "", "num", toint(bt.text), "left", 0 - 1, "right", 0 - 1, "line", bt.line, "kids", emptylist(0), "toks", emptylist(tokWitness), "stageKind", "", "stageArg", ""))))
                                also valstackE := concat(valstackE, list(newIdx)))
                                also kE := kE + 1)
                                also expectPrimary := 0)
                    else if bt.kind = "STRING" then
                        consider newIdx as length(parseArena) in
                            ((((v also parseArena := concat(parseArena, list(record("kind", "STR", "text", bt.text, "num", 0, "left", 0 - 1, "right", 0 - 1, "line", bt.line, "kids", emptylist(0), "toks", emptylist(tokWitness), "stageKind", "", "stageArg", ""))))
                                also valstackE := concat(valstackE, list(newIdx)))
                                also kE := kE + 1)
                                also expectPrimary := 0)
                    else if bt.kind = "MINUS" and expectPrimary = 1 then
                        if bt2.kind = "INT" then
                            consider newIdx as length(parseArena) in
                                ((((v also parseArena := concat(parseArena, list(record("kind", "NUM", "text", "", "num", 0 - toint(bt2.text), "left", 0 - 1, "right", 0 - 1, "line", bt.line, "kids", emptylist(0), "toks", emptylist(tokWitness), "stageKind", "", "stageArg", ""))))
                                    also valstackE := concat(valstackE, list(newIdx)))
                                    also kE := kE + 2)
                                    also expectPrimary := 0)
                        else
                            (v also unsupported := 1)
                    else if bt.kind = "IDENT" and (bt.text = "and" or bt.text = "or") and expectPrimary = 0 then
                        (((v also waitingE := bt.text) also kE := kE + 1) also expectPrimary := 1)
                    else if bt.kind = "IDENT" and bt.text = "ikke" and expectPrimary = 1 then
                        ((v also opstackE := concat(opstackE, list("NOT"))) also kE := kE + 1)
                    else if bt.kind = "IDENT" and bt.text = "if" and expectPrimary = 1 then
                        ((v also opstackE := concat(opstackE, list("IFCOND"))) also kE := kE + 1)
                    else if bt.kind = "IDENT" and bt.text = "then" and expectPrimary = 0 then
                        ((v also waitingE := "THEN") also kE := kE + 1)
                    else if bt.kind = "IDENT" and bt.text = "else" and expectPrimary = 0 then
                        ((v also waitingE := "ELSE") also kE := kE + 1)
                    else if bt.kind = "IDENT" and bt2.kind = "LPAREN" then
                        ((((((v also parenIsCall := concat(parenIsCall, list(1)))
                            also parenFuncName := concat(parenFuncName, list(bt.text)))
                            also parenValLen := concat(parenValLen, list(length(valstackE))))
                            also opstackE := concat(opstackE, list("(")))
                            also kE := kE + 2)
                            also expectPrimary := 1)
                    else if bt.kind = "IDENT" then
                        consider newIdx as length(parseArena) in
                            ((((v also parseArena := concat(parseArena, list(record("kind", "IDENT", "text", bt.text, "num", 0, "left", 0 - 1, "right", 0 - 1, "line", bt.line, "kids", emptylist(0), "toks", emptylist(tokWitness), "stageKind", "", "stageArg", ""))))
                                also valstackE := concat(valstackE, list(newIdx)))
                                also kE := kE + 1)
                                also expectPrimary := 0)
                    else if bt.kind = "LPAREN" then
                        ((((((v also parenIsCall := concat(parenIsCall, list(0)))
                            also parenFuncName := concat(parenFuncName, list("")))
                            also parenValLen := concat(parenValLen, list(length(valstackE))))
                            also opstackE := concat(opstackE, list("(")))
                            also kE := kE + 1)
                            also expectPrimary := 1)
                    else if bt.kind = "RPAREN" then
                        ((v also waitingE := "RPAREN") also kE := kE + 1)
                    else if bt.kind = "COMMA" then
                        ((v also waitingE := "COMMA") also kE := kE + 1)
                    else if bt.kind = "DOT" and expectPrimary = 0 then
                        ((v also waitingE := "DOT") also kE := kE + 1)
                    else
                        (((v also waitingE := bt.kind) also kE := kE + 1) also expectPrimary := 1)
                else
                    if waitingE = "DOT" then
                        if length(valstackE) = 0 or ikke (bt.kind = "IDENT") then
                            (v also unsupported := 1)
                        else
                            consider baseIdx as last(valstackE) in
                            consider vs1 as take(valstackE, length(valstackE) - 1) in
                            consider newIdx as length(parseArena) in
                                ((((v also parseArena := concat(parseArena, list(record("kind", "FIELD", "text", bt.text, "num", 0, "left", baseIdx, "right", 0 - 1, "line", bt.line, "kids", emptylist(0), "toks", emptylist(tokWitness), "stageKind", "", "stageArg", ""))))
                                    also valstackE := concat(vs1, list(newIdx)))
                                    also waitingE := "")
                                    also kE := kE + 1)
                    else if waitingE = "THEN" then
                        if length(opstackE) = 0 then
                            (v also unsupported := 1)
                        else if last(opstackE) = "IFCOND" then
                            consider condIdx as last(valstackE) in
                            consider vsC as take(valstackE, length(valstackE) - 1) in
                                ((((((v also valstackE := vsC)
                                    also ifCondStack := concat(ifCondStack, list(condIdx)))
                                    also opstackE := take(opstackE, length(opstackE) - 1))
                                    also opstackE := concat(opstackE, list("IFTHEN")))
                                    also waitingE := "")
                                    also expectPrimary := 1)
                        else
                            consider opsym as last(opstackE) in
                            if opsym = "NOT" then
                                consider cIdx as last(valstackE) in
                                consider vsC2 as take(valstackE, length(valstackE) - 1) in
                                consider newIdx as length(parseArena) in
                                    (((v also parseArena := concat(parseArena, list(record("kind", "NOT", "text", "", "num", 0, "left", cIdx, "right", 0 - 1, "line", bt.line, "kids", emptylist(0), "toks", emptylist(tokWitness), "stageKind", "", "stageArg", ""))))
                                        also valstackE := concat(vsC2, list(newIdx)))
                                        also opstackE := take(opstackE, length(opstackE) - 1))
                            else
                                consider rIdx as last(valstackE) in
                                consider vs1 as take(valstackE, length(valstackE) - 1) in
                                consider lIdx as last(vs1) in
                                consider vs2 as take(vs1, length(vs1) - 1) in
                                consider newIdx as length(parseArena) in
                                    (((v also parseArena := concat(parseArena, list(record("kind", opsym, "text", "", "num", 0, "left", lIdx, "right", rIdx, "line", bt.line, "kids", emptylist(0), "toks", emptylist(tokWitness), "stageKind", "", "stageArg", ""))))
                                        also valstackE := concat(vs2, list(newIdx)))
                                        also opstackE := take(opstackE, length(opstackE) - 1))
                    else if waitingE = "ELSE" then
                        if length(opstackE) = 0 then
                            (v also unsupported := 1)
                        else if last(opstackE) = "IFTHEN" then
                            consider thenIdx as last(valstackE) in
                            consider vsT as take(valstackE, length(valstackE) - 1) in
                                ((((((v also valstackE := vsT)
                                    also ifThenStack := concat(ifThenStack, list(thenIdx)))
                                    also opstackE := take(opstackE, length(opstackE) - 1))
                                    also opstackE := concat(opstackE, list("IFELSE")))
                                    also waitingE := "")
                                    also expectPrimary := 1)
                        else
                            consider opsym as last(opstackE) in
                            if opsym = "NOT" then
                                consider cIdx as last(valstackE) in
                                consider vsC2 as take(valstackE, length(valstackE) - 1) in
                                consider newIdx as length(parseArena) in
                                    (((v also parseArena := concat(parseArena, list(record("kind", "NOT", "text", "", "num", 0, "left", cIdx, "right", 0 - 1, "line", bt.line, "kids", emptylist(0), "toks", emptylist(tokWitness), "stageKind", "", "stageArg", ""))))
                                        also valstackE := concat(vsC2, list(newIdx)))
                                        also opstackE := take(opstackE, length(opstackE) - 1))
                            else
                                consider rIdx as last(valstackE) in
                                consider vs1 as take(valstackE, length(valstackE) - 1) in
                                consider lIdx as last(vs1) in
                                consider vs2 as take(vs1, length(vs1) - 1) in
                                consider newIdx as length(parseArena) in
                                    (((v also parseArena := concat(parseArena, list(record("kind", opsym, "text", "", "num", 0, "left", lIdx, "right", rIdx, "line", bt.line, "kids", emptylist(0), "toks", emptylist(tokWitness), "stageKind", "", "stageArg", ""))))
                                        also valstackE := concat(vs2, list(newIdx)))
                                        also opstackE := take(opstackE, length(opstackE) - 1))
                    else if waitingE = "RPAREN" or waitingE = "COMMA" then
                        if length(opstackE) = 0 then
                            (v also unsupported := 1)
                        else if last(opstackE) = "(" then
                            if waitingE = "COMMA" then
                                ((v also waitingE := "") also expectPrimary := 1)
                            else
                                consider nArgs as (length(valstackE) - last(parenValLen)) in
                                if last(parenIsCall) = 1 then
                                    consider fname as last(parenFuncName) in
                                    consider argIdxs as slice(valstackE, length(valstackE) - nArgs, length(valstackE)) in
                                    consider restVal as take(valstackE, length(valstackE) - nArgs) in
                                    consider newIdx as length(parseArena) in
                                        (((((((( v also parseArena := concat(parseArena, list(record("kind", "CALL", "text", fname, "num", 0, "left", 0 - 1, "right", 0 - 1, "line", bt.line, "kids", argIdxs, "toks", emptylist(tokWitness), "stageKind", "", "stageArg", ""))))
                                            also valstackE := concat(restVal, list(newIdx)))
                                            also opstackE := take(opstackE, length(opstackE) - 1))
