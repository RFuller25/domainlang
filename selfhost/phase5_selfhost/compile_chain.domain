    Cursed Technique: Apply
        Using: (v) -> (
            if unsupported = 1 or ikke (length(valstackE) = 1) then
                v
            else
                consider rootIdxE as last(valstackE) in
                consider ln2 as item(parseArena, li2) in
                consider updated2 as record("kind", ln2.kind, "text", ln2.text, "num", ln2.num, "left", rootIdxE, "right", ln2.right, "line", ln2.line, "kids", ln2.kids, "toks", ln2.toks, "stageKind", ln2.stageKind, "stageArg", ln2.stageArg) in
                    (v also parseArena := set(parseArena, li2, updated2))
