                    consider newIdx as length(parseArena) in
                        ((((( v also parseArena := concat(parseArena, list(record("kind", "IF", "text", "", "num", 0, "left", 0 - 1, "right", 0 - 1, "line", 0, "kids", list(condIdx, thenIdx, elseIdx), "toks", emptylist(tokWitness), "stageKind", "", "stageArg", ""))))
                                also valstackE := concat(vsE, list(newIdx)))
