                                    consider newIdx as length(parseArena) in
                                        (((v also parseArena := concat(parseArena, list(record("kind", "NOT", "text", "", "num", 0, "left", cIdx, "right", 0 - 1, "line", bt.line, "kids", emptylist(0), "toks", emptylist(tokWitness), "stageKind", "", "stageArg", ""))))
                                            also valstackE := concat(vsC, list(newIdx)))
                                            also opstackE := take(opstackE, length(opstackE) - 1))
                                else
