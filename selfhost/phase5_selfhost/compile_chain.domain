                                else if last(opstackE) = "and" then 2
                                else if last(opstackE) = "NOT" then 3
                                else if last(opstackE) = "EQ" or last(opstackE) = "LT" or last(opstackE) = "GT" or last(opstackE) = "LE" or last(opstackE) = "GE" then 4
                                else if last(opstackE) = "STAR" or last(opstackE) = "SLASH" or last(opstackE) = "PERCENT" then 8
                                else 6
                            ) in
