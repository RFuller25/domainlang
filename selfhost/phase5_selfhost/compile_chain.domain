                    consider newIdx as length(parseArena) in
                        (((v also parseArena := concat(parseArena, list(record("kind", "NOT", "text", "", "num", 0, "left", cIdx, "right", 0 - 1, "line", 0, "kids", emptylist(0), "toks", emptylist(tokWitness), "stageKind", "", "stageArg", ""))))
                            also valstackE := concat(vsC, list(newIdx)))
