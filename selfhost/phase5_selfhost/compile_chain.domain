    Cursed Technique: Apply
        Using: (v) -> (v also li2 := li2 + 1)

Cursed Object: numLines2 As length(parseArena)
Cursed Object: li3 As 0
Cursed Object: kindAcc As emptylist("")
Cursed Object: argAcc As emptylist("")
Cursed Object: seenColon As 0
Cursed Object: sj As 0

Cursed Technique: Apply
    Using: (v) -> 0
Simple Domain: While
    Using: (v) -> li3 < numLines2
    Cursed Object: nd3 Of (v) -> item(parseArena, li3)
    Cursed Object: isLine3 Of (v) -> nd3.kind = "LINE"

    Cursed Technique: Apply
        Using: (v) -> ((((v also kindAcc := emptylist("")) also argAcc := emptylist("")) also seenColon := 0) also sj := 0)

    Simple Domain: While
        Using: (v) -> isLine3 and sj < length(nd3.toks)
        Cursed Object: stok Of (v) -> item(nd3.toks, sj)
        Cursed Technique: Apply
            Using: (v) -> (
                if seenColon = 0 then
                    if stok.kind = "COLON" then
                        ((v also seenColon := 1) also sj := sj + 1)
                    else
                        ((v also kindAcc := concat(kindAcc, list(stok.text))) also sj := sj + 1)
                else
                    ((v also argAcc := concat(argAcc, list(stok.text))) also sj := sj + 1)
            )

    Cursed Technique: Apply
        Using: (v) -> (
            if isLine3 and seenColon = 1 then
                consider updated3 as record("kind", nd3.kind, "text", nd3.text, "num", nd3.num, "left", nd3.left, "right", nd3.right, "line", nd3.line, "kids", nd3.kids, "toks", nd3.toks, "stageKind", textjoin(kindAcc, " "), "stageArg", textjoin(argAcc, " ")) in
                    (v also parseArena := set(parseArena, li3, updated3))
            else
                v
        )

    Cursed Technique: Apply
        Using: (v) -> (v also li3 := li3 + 1)

Cursed Object: rootKids As item(parseArena, 0).kids
Cursed Object: nStages As length(rootKids)
Cursed Object: stageI As 1
Cursed Object: compileOK As 1
Cursed Object: goLines As emptylist("")
Cursed Object: curParamName As ""
Cursed Object: declaredNames As emptylist("")

Cursed Object: firstLine Of (v) -> item(parseArena, item(rootKids, 0))
Cursed Technique: Apply
    Using: (v) -> (
        if firstLine.stageKind = "Cursed Energy" and isdigit(firstLine.stageArg) then
            (v also goLines := concat(goLines, list("_dv := " + firstLine.stageArg)))
        else
            (v also compileOK := 0)
    )

Cursed Object: curG As (0 - 1)
Cursed Object: stkG As emptylist(0)
Cursed Object: orderG As emptylist(0)
Cursed Object: postorderG As emptylist(0)
Cursed Object: textStackG As emptylist("")

Cursed Technique: Apply
    Using: (v) -> 0
Simple Domain: While
    Using: (v) -> compileOK = 1 and stageI < nStages
    Cursed Object: curLineIdx Of (v) -> item(rootKids, stageI)
    Cursed Object: curLine Of (v) -> item(parseArena, curLineIdx)
    Cursed Object: usingIdx Of (v) -> (if length(curLine.kids) > 0 then item(curLine.kids, 0) else (0 - 1))
    Cursed Object: isApplyStage Of (v) -> (curLine.stageKind = "Cursed Technique" and curLine.stageArg = "Apply")
    Cursed Object: usingLineNode Of (v) -> (if usingIdx = (0 - 1) then curLine else item(parseArena, usingIdx))

    Cursed Technique: Apply
        Using: (v) -> (
            if curLine.stageKind = "Reveal" then
                (v also curG := (0 - 1))
            else if isApplyStage and ikke (usingIdx = (0 - 1)) and ikke (usingLineNode.left = (0 - 1)) and length(usingLineNode.toks) > 3 then
                ((v also curG := usingLineNode.left) also curParamName := item(usingLineNode.toks, 3).text)
            else
                ((v also curG := (0 - 1)) also compileOK := 0)
        )

    Cursed Technique: Apply
        Using: (v) -> (((v also stkG := (if curG = (0 - 1) then emptylist(0) else list(curG))) also orderG := emptylist(0)) also textStackG := emptylist(""))

    Simple Domain: While
        Using: (v) -> length(stkG) > 0
        Cursed Object: curGNodeIdx Of (v) -> last(stkG)
        Cursed Object: curGNode Of (v) -> item(parseArena, curGNodeIdx)
        Cursed Technique: Apply
            Using: (v) -> (
                if length(curGNode.kids) > 0 then
                    (((v also stkG := take(stkG, length(stkG) - 1))
                        also orderG := concat(orderG, list(curGNodeIdx)))
                        also stkG := concat(stkG, curGNode.kids))
                else
                    (((v also stkG := take(stkG, length(stkG) - 1))
                        also orderG := concat(orderG, list(curGNodeIdx)))
                        also stkG := (if curGNode.left = (0 - 1) then stkG else concat(stkG, list(curGNode.left))))
                        also stkG := (if curGNode.right = (0 - 1) then stkG else concat(stkG, list(curGNode.right)))
            )

    Cursed Technique: Apply
        Using: (v) -> (v also postorderG := reverse(orderG))

    Cursed Object: gqn Of (v) -> length(postorderG)
    Cursed Object: gqi As 0
    Cursed Technique: Apply
        Using: (v) -> (v also gqi := 0)

    Simple Domain: While
        Using: (v) -> gqi < gqn
        Cursed Object: gnode Of (v) -> item(parseArena, item(postorderG, gqi))
        Cursed Technique: Apply
            Using: (v) -> (
                if gnode.kind = "NUM" then
                    ((v also textStackG := concat(textStackG, list(totext(gnode.num)))) also gqi := gqi + 1)
                else if gnode.kind = "IDENT" then
                    ((v also textStackG := concat(textStackG, list(gnode.text))) also gqi := gqi + 1)
                else if gnode.kind = "STR" then
                    ((v also textStackG := concat(textStackG, list("\"" + replace(replace(gnode.text, "\\", "\\\\"), "\"", "\\\"") + "\""))) also gqi := gqi + 1)
                else if gnode.kind = "NOT" then
                    consider cT as last(textStackG) in
                    consider vsC as take(textStackG, length(textStackG) - 1) in
                        ((v also textStackG := concat(vsC, list("!(" + cT + ")"))) also gqi := gqi + 1)
                else if gnode.kind = "FIELD" then
                    consider bT as last(textStackG) in
                    consider vsB as take(textStackG, length(textStackG) - 1) in
                        ((v also textStackG := concat(vsB, list(bT + "." + gnode.text))) also gqi := gqi + 1)
                else if gnode.kind = "IF" then
                    consider elseT as last(textStackG) in
                    consider vsA as take(textStackG, length(textStackG) - 1) in
                    consider thenT as last(vsA) in
                    consider vsB2 as take(vsA, length(vsA) - 1) in
                    consider condT as last(vsB2) in
                    consider vsC2 as take(vsB2, length(vsB2) - 1) in
                    consider rv as ("func() int { if " + condT + " { return " + thenT + " }; return " + elseT + " }()") in
                        ((v also textStackG := concat(vsC2, list(rv))) also gqi := gqi + 1)
                else if gnode.kind = "CALL" then
                    consider nArgsG as length(gnode.kids) in
                    consider argTexts as slice(textStackG, length(textStackG) - nArgsG, length(textStackG)) in
                    consider restText as take(textStackG, length(textStackG) - nArgsG) in
                    consider rv as (gnode.text + "(" + textjoin(argTexts, ", ") + ")") in
                        ((v also textStackG := concat(restText, list(rv))) also gqi := gqi + 1)
                else if gnode.kind = "PLUS" or gnode.kind = "MINUS" or gnode.kind = "STAR" or gnode.kind = "SLASH" or gnode.kind = "PERCENT" or gnode.kind = "EQ" or gnode.kind = "LT" or gnode.kind = "GT" or gnode.kind = "LE" or gnode.kind = "GE" or gnode.kind = "and" or gnode.kind = "or" then
                    consider rT as last(textStackG) in
                    consider vs1G as take(textStackG, length(textStackG) - 1) in
                    consider lT as last(vs1G) in
                    consider vs2G as take(vs1G, length(vs1G) - 1) in
                    consider rv as (
                        if gnode.kind = "PLUS" then "(" + lT + " + " + rT + ")"
                        else if gnode.kind = "MINUS" then "(" + lT + " - " + rT + ")"
                        else if gnode.kind = "STAR" then "(" + lT + " * " + rT + ")"
                        else if gnode.kind = "SLASH" then "(" + lT + " / " + rT + ")"
                        else if gnode.kind = "PERCENT" then "mod(" + lT + ", " + rT + ")"
                        else if gnode.kind = "EQ" then "(" + lT + " == " + rT + ")"
                        else if gnode.kind = "LT" then "(" + lT + " < " + rT + ")"
                        else if gnode.kind = "GT" then "(" + lT + " > " + rT + ")"
                        else if gnode.kind = "LE" then "(" + lT + " <= " + rT + ")"
                        else if gnode.kind = "GE" then "(" + lT + " >= " + rT + ")"
                        else if gnode.kind = "and" then "(" + lT + " && " + rT + ")"
                        else "(" + lT + " || " + rT + ")"
                    ) in
                        ((v also textStackG := concat(vs2G, list(rv))) also gqi := gqi + 1)
                else
                    ((v also textStackG := concat(textStackG, list("/* unsupported: " + gnode.kind + " */"))) also gqi := gqi + 1)
            )

    Cursed Technique: Apply
        Using: (v) -> (
            if curG = (0 - 1) then
                v
            else if compileOK = 1 and length(textStackG) = 1 then
                consider declOp as (if contains(declaredNames, curParamName) then " = _dv" else " := _dv") in
                    (((v also goLines := concat(goLines, list(curParamName + declOp)))
                        also declaredNames := (if contains(declaredNames, curParamName) then declaredNames else concat(declaredNames, list(curParamName))))
                        also goLines := concat(goLines, list("_dv = " + last(textStackG))))
            else
                (v also compileOK := 0)
        )

    Cursed Technique: Apply
        Using: (v) -> (v also stageI := stageI + 1)

Cursed Technique: Apply
    Using: (v) -> (
        if compileOK = 1 then
            "package main\n\nimport \"fmt\"\n\nfunc mod(a, b int) int {\n\tm := a % b\n\tif m < 0 {\n\t\tm += b\n\t}\n\treturn m\n}\n\nfunc main() {\n\t" + textjoin(goLines, "\n\t") + "\n\tfmt.Println(_dv)\n}\n"
        else
            "// COMPILE_FAILED"
    )
Reveal: stdout
