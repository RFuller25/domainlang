func dmParseInt(s string) int64 {
	t := strings.TrimSpace(s)
	// Fast path: a plain decimal that provably fits in int64 (<=18 digits)
	// parses inline; anything else defers to strconv for exact semantics.
	if n := len(t); n > 0 && n <= 19 {
		i, neg := 0, false
		if t[0] == '-' || t[0] == '+' {
			neg = t[0] == '-'
			i = 1
		}
		if d := n - i; d >= 1 && d <= 18 {
			var v int64
			ok := true
			for ; i < n; i++ {
				c := t[i]
				if c < '0' || c > '9' {
					ok = false
					break
				}
