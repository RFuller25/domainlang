Cursed Energy: stdin
Cursed Technique: Apply
    Using: (s) -> trim(s)
Cursed Object: srcText Of Itself
Cursed Object: n As length(srcText)
Cursed Object: tokens As emptylist("")
Cursed Object: buf As ""
Cursed Technique: Apply
    Using: (s) -> 0
Simple Domain: While
    Using: (i) -> i < n
    Cursed Object: c Of (i) -> charat(srcText, i)
    Cursed Technique: Apply
        Using: (i) -> (
            if c = " " then
                (((i + 1) also tokens := (if buf = "" then tokens else concat(tokens, list(buf)))) also buf := "")
            else if isdigit(c) then
                ((i + 1) also buf := buf + c)
            else
                ((((i + 1) also tokens := (if buf = "" then tokens else concat(tokens, list(buf)))) also buf := "") also tokens := concat(tokens, list(c)))
        )
Cursed Technique: Apply
    Using: (i) -> (if buf = "" then tokens else concat(tokens, list(buf))) also tokens := (if buf = "" then tokens else concat(tokens, list(buf)))

Cursed Object: m As length(tokens)
Cursed Object: rpn As emptylist("")
Cursed Object: opstack As emptylist("")
Cursed Object: j As 0
Cursed Object: waiting As ""
Cursed Technique: Apply
    Using: (x) -> 0
Simple Domain: While
    Using: (v) -> j < m or ikke waiting = ""
    Cursed Technique: Apply
        Using: (v) -> (
            if waiting = "" then
                consider t as item(tokens, j) in
                    if isdigit(t) then
                        (((v also j := j + 1)) also rpn := concat(rpn, list(t)))
                    else if t = "(" then
                        (((v also j := j + 1)) also opstack := concat(opstack, list(t)))
                    else
                        ((v also j := j + 1) also waiting := t)
            else if waiting = ")" then
                consider top as last(opstack) in
                    if top = "(" then
                        ((v also opstack := take(opstack, length(opstack) - 1)) also waiting := "")
                    else
                        ((v also rpn := concat(rpn, list(top))) also opstack := take(opstack, length(opstack) - 1))
            else
                if length(opstack) = 0 then
                    ((v also opstack := concat(opstack, list(waiting))) also waiting := "")
                else if last(opstack) = "(" then
                    ((v also opstack := concat(opstack, list(waiting))) also waiting := "")
                else if ikke ((last(opstack) = "+" or last(opstack) = "-") and (waiting = "*" or waiting = "/")) then
                    ((v also rpn := concat(rpn, list(last(opstack)))) also opstack := take(opstack, length(opstack) - 1))
                else
                    ((v also opstack := concat(opstack, list(waiting))) also waiting := "")
        )
Cursed Technique: Apply
    Using: (v) -> v
Simple Domain: While
    Using: (v) -> length(opstack) > 0
    Cursed Technique: Apply
        Using: (v) -> ((v also rpn := concat(rpn, list(last(opstack)))) also opstack := take(opstack, length(opstack) - 1))
Cursed Technique: Apply
    Using: (v) -> rpn
Reveal: stderr

Cursed Object: arena As emptylist(record("kind", "num", "num", 0, "left", 0 - 1, "right", 0 - 1))
Cursed Object: valstack As emptylist(0)
Cursed Object: p As 0
Cursed Object: pn As length(rpn)
Cursed Technique: Apply
    Using: (v) -> 0
Simple Domain: While
    Using: (v) -> p < pn
    Cursed Object: tk Of (v) -> item(rpn, p)
    Cursed Technique: Apply
        Using: (v) -> (
            if isdigit(tk) then
                consider newIdx as length(arena) in
                    (((v also arena := concat(arena, list(record("kind", "num", "num", toint(tk), "left", 0 - 1, "right", 0 - 1))))
                        also valstack := concat(valstack, list(newIdx)))
                        also p := p + 1)
            else
                consider r as last(valstack) in
                consider vs1 as take(valstack, length(valstack) - 1) in
                consider l as last(vs1) in
                consider vs2 as take(vs1, length(vs1) - 1) in
                consider newIdx as length(arena) in
                    (((v also arena := concat(arena, list(record("kind", tk, "num", 0, "left", l, "right", r))))
                        also valstack := concat(vs2, list(newIdx)))
                        also p := p + 1)
        )
Cursed Object: rootIdx Of (v) -> last(valstack)
Cursed Technique: Apply
    Using: (v) -> rootIdx
Reveal: stderr

Cursed Object: stk1 As list(rootIdx)
Cursed Object: order As emptylist(0)
Cursed Technique: Apply
    Using: (v) -> 0
Simple Domain: While
    Using: (v) -> length(stk1) > 0
    Cursed Object: curIdx Of (v) -> last(stk1)
    Cursed Object: nd Of (v) -> item(arena, curIdx)
    Cursed Technique: Apply
        Using: (v) -> (
            ((((v also stk1 := take(stk1, length(stk1) - 1))
                also order := concat(order, list(curIdx)))
                also stk1 := (if nd.left = 0 - 1 then stk1 else concat(stk1, list(nd.left))))
                also stk1 := (if nd.right = 0 - 1 then stk1 else concat(stk1, list(nd.right))))
        )
Reveal: stderr

Cursed Object: postorder Of (v) -> reverse(order)

Cursed Object: valstack2 As emptylist(0)
Cursed Object: textstack As emptylist("")
Cursed Object: q As 0
Cursed Object: qn As length(postorder)
Cursed Technique: Apply
    Using: (v) -> 0
Simple Domain: While
    Using: (v) -> q < qn
    Cursed Object: nd2 Of (v) -> item(arena, item(postorder, q))
    Cursed Technique: Apply
        Using: (v) -> (
            if nd2.kind = "num" then
                (((v also valstack2 := concat(valstack2, list(nd2.num)))
                    also textstack := concat(textstack, list(totext(nd2.num))))
                    also q := q + 1)
            else
                consider bnum as last(valstack2) in
                consider vsA as take(valstack2, length(valstack2) - 1) in
                consider anum as last(vsA) in
                consider vsB as take(vsA, length(vsA) - 1) in
                consider btxt as last(textstack) in
                consider tsA as take(textstack, length(textstack) - 1) in
                consider atxt as last(tsA) in
                consider tsB as take(tsA, length(tsA) - 1) in
                consider rnum as (
                    if nd2.kind = "+" then anum + bnum
                    else if nd2.kind = "-" then anum - bnum
                    else if nd2.kind = "*" then anum * bnum
                    else anum / bnum
                ) in
                    (((v also valstack2 := concat(vsB, list(rnum)))
                        also textstack := concat(tsB, list("(" + atxt + " " + nd2.kind + " " + btxt + ")")))
                        also q := q + 1)
        )

Cursed Technique: Apply
    Using: (v) -> "eval=" + totext(last(valstack2)) + "  go=" + last(textstack)
Reveal: stdout

